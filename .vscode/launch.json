{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Audio Harness: serve",
      "type": "debugpy",
      "request": "launch",
      "module": "audio_harness.commands.app",
      "args": [
        "serve",
        "--grpc-port",
        "0",
        "--http-port",
        "0"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Audio Harness: build web"
    }
  ]
}
