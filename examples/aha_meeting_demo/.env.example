# Audio Harness Realtime 的 HTTP(S) 基地址；Demo 会自动转换为 WS(S)。
REALTIME_BASE_URL=https://127.0.0.1:8000/v1
REALTIME_API_KEY=local-demo-key
# 已激活、公开的 Audio Workflow Route 名称。
REALTIME_MODEL=ai-meeting
# 使用本地自签名证书时填写仓库根目录相对路径；连接公网服务时留空。
REALTIME_CA_CERT_FILE=model-bin/realtime-tls/cert.pem

# Demo 自己的 HTTPS 服务。首次使用请在仓库根目录运行：bash scripts/generate_realtime_tls.sh
MEETING_DEMO_TLS_CERT_FILE=model-bin/realtime-tls/cert.pem
MEETING_DEMO_TLS_KEY_FILE=model-bin/realtime-tls/key.pem
MEETING_DEMO_HOST=0.0.0.0
MEETING_DEMO_PORT=8092
