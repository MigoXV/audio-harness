# Audio Harness 服务启动配置
# serve 不会自动读取 .env；请通过 shell、容器的 env-file 或 IDE 的 envFile 注入。
# 命令行参数优先于同名环境变量；修改启动配置后需要重启服务。

# 数据库与持久化目录
DATABASE_URL=sqlite+aiosqlite:///./data-bin/sqlite/audio-harness.db
VOICE_STORAGE_DIR=./data-bin/voices
RECEIVED_AUDIO_CACHE_DIR=./data-bin/cache

# HTTP / WSS / WebRTC 信令监听地址
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# aha-grpc TLS 监听地址；默认 50051，端口设为 0 时自动选择空闲端口。
# 这是 Audio Harness 自身的服务端口，外部推理引擎地址在资源的 target 中配置。
AHA_GRPC_HOST=0.0.0.0
AHA_GRPC_PORT=50051

# HTTP 与 aha-grpc 共用的 TLS 证书和私钥；启动前应存在且可读。
HTTP_TLS_CERT_FILE=model-bin/realtime-tls/cert.pem
HTTP_TLS_KEY_FILE=model-bin/realtime-tls/key.pem

# Qdrant：两项必须同时配置；不用向量检索时，同时注释掉下面两行。
# 以下地址是部署示例，代码默认不配置 Qdrant。
QDRANT_GRPC_TARGET=192.168.0.222:16334
QDRANT_HTTP_URL=http://192.168.0.222:16333

# WebSocket、WebRTC、aha-grpc 与下游 gRPC 的单消息字节上限（默认 4 MiB）。
MAX_MESSAGE_BYTES=4194304

# WebRTC：完整 JSON 数组；在 shell 中加载时，用单引号包住 JSON。
# STUN 示例：'[{"urls":"stun:ice.example:3478"}]'
# TURN 示例：'[{"urls":"turn:ice.example:3478","username":"demo","credential":"replace-me"}]'
WEBRTC_ICE_SERVERS_JSON='[]'
# 协商超时与断连宽限，单位为秒。
WEBRTC_NEGOTIATION_TIMEOUT_SECONDS=10
WEBRTC_DISCONNECTED_GRACE_SECONDS=10

# 服务日志级别
LOG_LEVEL=INFO

# 以下凭据变量名仅为示例，不是固定启动参数；按对应资源的配置显式引用。
# Responses 引擎：credential_env=MODEL_API_KEY；直接配置 api_key 时优先使用 api_key。
# MODEL_API_KEY='replace-me'
# DSH 后端：headers_env={"Authorization":"DSH_AUTH_HEADER"}。
# DSH_AUTH_HEADER='Bearer replace-me'
# MCP 服务：headers_env={"X-API-Key":"MCP_API_KEY"}。
# MCP_API_KEY='replace-me'

# 可选抓包工具 scripts/capture_openai_realtime.py 使用此变量；服务不会用它自动注册引擎。
# 抓包工具会静态读取项目 .env 中的 OPENAI_API_KEY，进程环境中的值优先。
# OPENAI_API_KEY='replace-me'

# 工作流参数、运行容量、音频缓存启停等在管理 API / 控制台中配置并持久化，
# 没有对应的固定启动环境变量；请勿自行添加同名变量并期待它们生效。
